# Postgres (no Coolify: hostname interno do recurso PostgreSQL, porta 5432)
PG_HOST=
PG_PORT=5432
PG_USER=cadastro
PG_PASSWORD=
PG_DB=cadastro_produtos

# Necessária para o enriquecimento (formatação via Claude). Nunca comitar a chave real.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Origens permitidas pelo CORS, separadas por vírgula (URL do frontend)
CORS_ORIGINS=https://seu-frontend.exemplo.com

# Intervalo mínimo (s) entre requisições ao mesmo site do crawler
CRAWLER_SLEEP_SEGUNDOS=1.5
